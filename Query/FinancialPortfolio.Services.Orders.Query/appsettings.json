{
    "AllowedHosts": "*",
    "Kestrel": {
        "EndpointDefaults": {
            "Protocols": "Http2"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Grpc.AspNetCore.Server": "Warning"
            }
        },
        "Properties": {
            "Application": "Orders Query"
        }
    },
    "MongoSettings": {
        "DatabaseName": "Orders"
    }
}
